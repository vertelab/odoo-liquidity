<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The basis: what is owed, and why. The reason column is not decoration;
         a reader who cannot see the arithmetic cannot disagree with it. -->
    <record id="view_liquidity_agency_basis_list" model="ir.ui.view">
        <field name="name">liquidity.agency.commission.basis.list</field>
        <field name="model">liquidity.agency.commission.basis</field>
        <field name="arch" type="xml">
            <list string="Commission basis" create="false" delete="false"
                  decoration-danger="source != 'agency'"
                  decoration-muted="state in ('ended', 'draft')">
                <field name="agency_partner_id"/>
                <field name="tenant_id"/>
                <field name="source" widget="badge"/>
                <field name="state" widget="badge"/>
                <field name="base_amount" widget="monetary" optional="show"/>
                <field name="signup_amount" widget="monetary" sum="Signup"/>
                <field name="recurring_amount" widget="monetary" sum="Recurring"/>
                <field name="total_amount" widget="monetary" sum="Total"/>
                <field name="reason"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_liquidity_agency_basis_wizard_form" model="ir.ui.view">
        <field name="name">liquidity.agency.basis.wizard.form</field>
        <field name="model">liquidity.agency.basis.wizard</field>
        <field name="arch" type="xml">
            <form string="Build commission basis">
                <p class="text-muted">
                    The amount is what each customer paid for the period. This
                    module knows the rules; you know what was paid. It computes
                    the basis and shows its arithmetic — it does not invoice.
                </p>
                <group>
                    <group>
                        <field name="period_start"/>
                        <field name="period_end"/>
                    </group>
                    <group>
                        <field name="agency_partner_id"/>
                        <field name="base_amount"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_build" type="object" string="Build"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_liquidity_agency_basis_wizard" model="ir.actions.act_window">
        <field name="name">Build commission basis</field>
        <field name="res_model">liquidity.agency.basis.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_liquidity_agency_basis" model="ir.actions.act_window">
        <field name="name">Commission basis</field>
        <field name="res_model">liquidity.agency.commission.basis</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No basis built yet</p>
            <p>Build a basis for a period to see what each agreement earned and
               why. It shows the arithmetic; it does not pay anything out.</p>
        </field>
    </record>

</odoo>
