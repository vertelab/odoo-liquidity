<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_liquidity_tenant_list" model="ir.ui.view">
        <field name="name">liquidity.tenant.list</field>
        <field name="model">liquidity.tenant</field>
        <field name="arch" type="xml">
            <list string="Source instances" create="true" delete="true"
                  decoration-danger="state in ('error', 'auth_error', 'auth_expired')"
                  decoration-warning="state in ('no_liquidity', 'rate_limited')"
                  decoration-success="state == 'ok'">
                <field name="name"/>
                <field name="source_type" widget="badge"/>
                <field name="source" widget="badge"
                       decoration-info="source == 'vertel'"
                       decoration-warning="source == 'agency'"/>
                <field name="base_url"/>
                <field name="db_name"/>
                <field name="login"/>
                <field name="state" widget="badge"
                       decoration-danger="state in ('error', 'auth_error', 'auth_expired')"
                       decoration-warning="state in ('no_liquidity', 'rate_limited')"
                       decoration-success="state == 'ok'"/>
                <field name="company_count"/>
                <field name="liquidity_version"/>
                <field name="last_connected_at"/>
            </list>
        </field>
    </record>

    <record id="view_liquidity_tenant_form" model="ir.ui.view">
        <field name="name">liquidity.tenant.form</field>
        <field name="model">liquidity.tenant</field>
        <field name="arch" type="xml">
            <form string="Source instance">
                <header>
                    <button name="action_connect_and_import" type="object"
                            string="Connect and import companies" class="btn-primary"
                            invisible="state == 'ok'"/>
                    <button name="action_import_companies" type="object"
                            string="Fetch company list again" class="btn-secondary"
                            invisible="state != 'ok'"/>
                    <button name="action_test_connection" type="object"
                            string="Test connection" class="btn-link"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,ok"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Customer name"/></h1>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="source_type"/>
                            <field name="source"/>
                            <field name="owning_agency_id"
                                   invisible="source != 'agency'"/>
                            <field name="base_url" placeholder="https://kund.vertel.se"/>
                            <field name="db_name" placeholder="databasnamn"
                                   invisible="source_type != 'odoo'"/>
                            <field name="login" placeholder="odoouser@kund.se"
                                   invisible="source_type != 'odoo'"/>
                            <field name="visma_product"
                                   invisible="source_type != 'visma'"/>
                            <field name="keykeep_ref"
                                   placeholder="keykeep credential label"/>
                            <field name="bridge_keykeep_ref"
                                   placeholder="keykeep bridge key label"
                                   invisible="source_type != 'odoo'"/>
                        </group>
                        <group string="Status">
                            <field name="last_connected_at"/>
                            <field name="liquidity_version"/>
                            <field name="request_timeout"/>
                        </group>
                    </group>
                    <group string="Accounts" colspan="2">
                        <div colspan="2">
                            <p class="text-muted">
                                One account per consultant. A firm with eight
                                consultants has eight rows here, not one shared
                                login — the access log has to name a person.
                            </p>
                        </div>
                        <field name="account_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="consultant_id"/>
                                <field name="consultant_ref"/>
                                <field name="login"/>
                                <field name="keykeep_ref"/>
                                <field name="is_agency_account"/>
                                <field name="agency_partner_id"/>
                                <field name="last_used_at" readonly="1"/>
                                <field name="active"/>
                            </list>
                        </field>
                    </group>
                    <group string="Companies" colspan="2">
                        <field name="company_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="name"/>
                                <field name="company_ref"/>
                                <field name="currency_name"/>
                                <field name="active"/>
                                <field name="missing_since"/>
                            </list>
                        </field>
                    </group>
                    <field name="last_error" readonly="1"
                           invisible="not last_error"/>
                    <div class="alert alert-info" role="alert"
                         invisible="source_type == 'odoo'">
                        <p><strong>A driven source is not the same kind of truth.</strong></p>
                        <p class="mb-0">
                            An Odoo source has <code>liquidity_forecast</code>
                            installed and its figures are read as they are. A
                            Fortnox or Visma source has no such module: the
                            portfolio fetches underlag and derives the figures
                            itself. The requirement for those rows is that the
                            figures can be derived from the customer's own
                            bookkeeping — not that they match a screen in
                            another system. The list marks the difference, and a
                            figure the source cannot carry is left out rather
                            than shown as zero.
                        </p>
                    </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_liquidity_tenant" model="ir.actions.act_window">
        <field name="name">Sources</field>
        <field name="res_model">liquidity.tenant</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No sources yet</p>
            <p>Add the Odoo instance you want to read liquidity from. The API key
               belongs to the user who bookkeeps for that customer and is stored
               in keykeep.</p>
        </field>
    </record>

</odoo>
