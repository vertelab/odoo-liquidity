<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Housekeeping: move agreements whose ramp has run out to 'ended'.
             The computation already returns zero past recurring_until, so this
             is the record catching up with the arithmetic, not the guard. -->
        <record id="ir_cron_agency_finish_ending" model="ir.cron">
            <field name="name">Agency: finish expired ramps</field>
            <field name="model_id" ref="model_liquidity_agency_agreement"/>
            <field name="state">code</field>
            <field name="code">model._cron_finish_ending()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
