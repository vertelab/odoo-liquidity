<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Two tasks, deliberately ordered:
              sequence 10  liquidity_forecast_recompute   (liquidity_forecast)
              sequence 20  liquidity_simulation_compute   (this module)
              sequence 30  liquidity_payment_profiles     (this module)

            The simulation reads the forecast's daily lines, so it must run
            after them. The profiles are rebuilt weekly rather than nightly:
            payment behaviour changes slowly, and a weekly rebuild keeps the
            nightly simulation cheap.

            Scheduling goes through cron_tick, never ir.cron — cadence,
            deterministic spread and run history belong to that engine.
        -->
        <record id="cron_task_liquidity_simulation_compute" model="cron.task">
            <field name="name">Liquidity: run simulation</field>
            <field name="technical_name">liquidity_simulation_compute</field>
            <field name="module">liquidity_simulation</field>
            <field name="model_name">liquidity.simulation</field>
            <field name="method_name">_cron_simulate_all</field>
            <field name="cadence">daily</field>
            <field name="sequence">20</field>
        </record>

        <record id="cron_task_liquidity_payment_profiles" model="cron.task">
            <field name="name">Liquidity: refresh payment profiles</field>
            <field name="technical_name">liquidity_payment_profiles_refresh</field>
            <field name="module">liquidity_simulation</field>
            <field name="model_name">liquidity.payment.profile</field>
            <field name="method_name">_cron_refresh_payment_profiles</field>
            <field name="cadence">week</field>
            <field name="sequence">30</field>
        </record>
    </data>
</odoo>
