# p-filer är källkod i sitt eget språk. Utan detta behandlas de som binärer
# eller får CRLF, och då slutar preprocessorn att känna igen dem.
*.p.py   text eol=lf
*.p.xml  text eol=lf
*.p.js   text eol=lf
*.p.csv  text eol=lf

