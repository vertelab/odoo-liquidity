<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_liquidity_work_template_list" model="ir.ui.view">
        <field name="name">liquidity.work.template.list</field>
        <field name="model">liquidity.work.template</field>
        <field name="arch" type="xml">
            <list string="Work plan templates">
                <field name="name"/>
                <field name="company_id"/>
                <field name="line_count"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_liquidity_work_template_form" model="ir.ui.view">
        <field name="name">liquidity.work.template.form</field>
        <field name="model">liquidity.work.template</field>
        <field name="arch" type="xml">
            <form string="Work plan template">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Monthly bookkeeping"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="description_excerpt" optional="show"/>
                            <field name="interval_number"/>
                            <field name="interval_type"/>
                            <field name="offset_days"/>
                            <field name="responsible_role"/>
                            <field name="estimated_minutes"/>
                        </list>
                        <form string="Action">
                            <group>
                                <group>
                                    <field name="name"/>
                                    <field name="interval_number"/>
                                    <field name="interval_type"/>
                                    <field name="offset_days"/>
                                </group>
                                <group>
                                    <field name="responsible_role"/>
                                    <field name="estimated_minutes"/>
                                    <field name="sequence"/>
                                </group>
                            </group>
                            <field name="description" widget="html"/>
                        </form>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_liquidity_work_template" model="ir.actions.act_window">
        <field name="name">Plan templates</field>
        <field name="res_model">liquidity.work.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
