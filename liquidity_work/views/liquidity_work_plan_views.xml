<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_liquidity_work_plan_list" model="ir.ui.view">
        <field name="name">liquidity.work.plan.list</field>
        <field name="model">liquidity.work.plan</field>
        <field name="arch" type="xml">
            <list string="Work plans" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="company_id"/>
                <field name="partner_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="open_order_count" string="Open"/>
                <field name="order_count" string="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'running'"
                       decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_liquidity_work_plan_form" model="ir.ui.view">
        <field name="name">liquidity.work.plan.form</field>
        <field name="model">liquidity.work.plan</field>
        <field name="arch" type="xml">
            <form string="Work plan">
                <header>
                    <button name="action_close" type="object" string="Close"
                            invisible="state == 'closed'"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Plan">
                            <field name="company_id" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group string="Source">
                            <field name="template_id"/>
                            <field name="sale_order_id"/>
                            <field name="sale_line_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="description_excerpt"/>
                                    <field name="interval_number"/>
                                    <field name="interval_type"/>
                                    <field name="offset_days"/>
                                    <field name="responsible_role"/>
                                    <field name="estimated_minutes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Work orders" name="orders">
                            <field name="order_ids" readonly="1">
                                <list>
                                    <field name="period_start"/>
                                    <field name="name"/>
                                    <field name="date_deadline"/>
                                    <field name="state" widget="badge"
                                           decoration-danger="is_overdue"
                                           decoration-success="state == 'done'"/>
                                    <field name="user_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_liquidity_work_plan" model="ir.actions.act_window">
        <field name="name">Plans</field>
        <field name="res_model">liquidity.work.plan</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
