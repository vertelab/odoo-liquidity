#!/bin/sh
# Expandera staged p-filer för den här grenens utgåva innan commit.
#
# Utan detta kan en p-fil committas utan att utdata uppdateras, och nästa
# expansion river fixen tyst. Utdata MÅSTE committas -- Odoo läser .py/.xml,
# aldrig .p.py/.p.xml.
set -e

EDITION=$(git rev-parse --abbrev-ref HEAD 2>/dev/null | grep -Eo '^[0-9]+\.[0-9]+' || echo "18.0")
command -v preprocess >/dev/null 2>&1 || {
    echo "pre-commit: preprocess saknas — hoppar över expansion." >&2
    echo "            installera: python3 -m pip install --break-system-packages preprocess" >&2
    exit 0
}

staged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.p\.(py|xml|js|csv)$' || true)
[ -z "$staged" ] && exit 0

echo "$staged" | while read -r src; do
    [ -f "$src" ] || continue
    out=$(echo "$src" | sed -E 's/\.p\.(py|xml|js|csv)$/.\1/')
    rm -f "$out"
    preprocess -f -D "VERSION=$EDITION" -o "$out" "$src"
    git add "$out"
    echo "  expanderade $src -> $out ($EDITION)"
done
