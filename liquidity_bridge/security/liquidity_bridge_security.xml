<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- The customer's own administrators see everything the bridge did.
             Nobody else needs to: the access log exists for the customer to
             audit the firm, and the outbox is the customer's own queue. -->
        <record id="group_bridge_manager" model="res.groups">
            <field name="name">Liquidity Bridge / Administrator</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_manager'))]"/>
        </record>
        <!-- The one group an agency account may belong to. Accounting rights
             only: no HR, no payroll, no settings, no user administration.
             Created here rather than by the customer, so that every customer
             grants the same thing and the firm can reason about it once. -->
        <record id="group_agency_consultant" model="res.groups">
            <field name="name">Liquidity Bridge / Agency consultant</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
            <field name="comment">Granted to consultants the accounting firm's
                                  bridge creates. Accounting rights only.</field>
        </record>
    </data>
</odoo>
