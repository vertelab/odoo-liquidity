<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The customer's own view of the queue. It exists so a stuck event is
         something the customer can see, not something they discover by
         asking why nobody answered. -->
    <record id="view_bridge_outbox_list" model="ir.ui.view">
        <field name="name">bridge.outbox.list</field>
        <field name="model">bridge.outbox</field>
        <field name="arch" type="xml">
            <list string="Sent to the firm" create="false" delete="false"
                  decoration-danger="state == 'failed'"
                  decoration-muted="state == 'delivered'">
                <field name="summary"/>
                <field name="event_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="res_reference"/>
                <field name="user_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'delivered'"
                       decoration-danger="state == 'failed'"
                       decoration-warning="state == 'sending'"/>
                <field name="attempts"/>
                <field name="last_attempt_at" optional="show"/>
                <field name="delivered_at" optional="show"/>
                <field name="last_error" optional="hide"/>
                <field name="create_date" string="Created"/>
            </list>
        </field>
    </record>

    <record id="view_bridge_outbox_form" model="ir.ui.view">
        <field name="name">bridge.outbox.form</field>
        <field name="model">bridge.outbox</field>
        <field name="arch" type="xml">
            <form string="Sent to the firm" create="false" delete="false">
                <header>
                    <button name="action_retry" type="object" string="Try again"
                            class="btn-secondary"
                            invisible="state not in ('failed', 'queued')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="queued,delivered"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="summary"/>
                            <field name="event_type"/>
                            <field name="res_reference"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="uuid" readonly="1"/>
                            <field name="attempts"/>
                            <field name="last_attempt_at"/>
                            <field name="delivered_at"/>
                        </group>
                    </group>
                    <field name="body" readonly="1" invisible="not body"/>
                    <field name="last_error" readonly="1"
                           invisible="not last_error"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bridge_outbox" model="ir.actions.act_window">
        <field name="name">Sent to the firm</field>
        <field name="res_model">bridge.outbox</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing sent yet</p>
            <p>Questions you send from an invoice or a journal entry appear
               here until the accounting firm has received them.</p>
        </field>
    </record>

</odoo>
