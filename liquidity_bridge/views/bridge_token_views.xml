<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Issued tokens. Read-only on purpose: a token is created by an API
         call, never by hand, and it cannot be edited into something longer
         lived. -->
    <record id="view_bridge_token_list" model="ir.ui.view">
        <field name="name">bridge.token.list</field>
        <field name="model">bridge.token</field>
        <field name="arch" type="xml">
            <list string="Session tokens" create="false" delete="false"
                  decoration-muted="used_at">
                <field name="token" invisible="1"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="issued_by"/>
                <field name="create_date" string="Issued"/>
                <field name="expires_at"/>
                <field name="used_at"/>
                <field name="menu_xmlid" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_bridge_token" model="ir.actions.act_window">
        <field name="name">Session tokens</field>
        <field name="res_model">bridge.token</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
